// Waybar (Hyprland): one bar definition, instantiated on every output. Everything lives in
//  modules-hyprland.jsonc. There is deliberately no "output" key: naming connectors (DP-1, DP-2, ...) breaks
//  on a dock, whose MST monitors come back as fresh connectors (DP-6, DP-7, ...) after a replug,
//  and an output with no matching entry gets no bar at all. The brightness module still shows each
//  monitor's own value: waybar exports WAYBAR_OUTPUT_NAME to a custom module's exec, which
//  scripts/brightness.sh reads when given "self".
[
    {
        "include": ["~/.config/waybar/modules-hyprland.jsonc"]
    }
]
