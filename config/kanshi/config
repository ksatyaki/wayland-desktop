# kanshi: applies a profile when exactly this set of outputs is connected (used under Sway)
profile laptop {
    output eDP-1 enable position 0,0 scale 1.25
}
profile home {
    output eDP-1 enable position 0,160 scale 1.25
    output "Lenovo Group Limited G27q-20 U63330HD" enable position 2048,0
    output "HP Inc. HP E24u G5 CN43172GTD" enable position 4608,360
}
profile office {
    output eDP-1 disable
    output "Dell Inc. DELL U2422H 3119RP3" enable position 0,360
    output "AOC Q27G42XE 1O0R4HA008572" enable position 1920,0
    output "Dell Inc. DELL U2422H 85LJRP3" enable position 4480,360
}
