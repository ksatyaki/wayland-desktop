# Sway look: title font and window colours (included by ~/.config/sway/config).
# Catppuccin Mocha with the DOOM Eternal font. The DOOM: The Dark Ages version is themes/dark-ages/config/sway/theme
# in the repo; ./install.sh --theme dark-ages installs that one instead.

# DOOM Eternal font; Bold is caps-only, suits title bars (sway takes no trailing comment on a font line)
font pango:Eternal UI Bold 11

